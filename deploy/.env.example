# Required
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
ADMIN_PASSWORD=change-me

# Public origin, used for tracking links in email, sitemap.xml and Stripe returns
PUBLIC_SITE_URL=https://turkiyetraveloffice.com

# Extra browser origins allowed to call the API (a native app shell, staging).
# Same-origin web traffic never needs an entry here.
ALLOWED_ORIGINS=

# AI chat. Without a key the chat replies with an error instead of crashing.
OPENAI_API_KEY=
MAX_HISTORY_MESSAGES=20

# Transactional email (Resend). Without both values no email is sent and the
# API reports email_sent:false rather than claiming a message was delivered.
RESEND_API_KEY=
EMAIL_FROM=Türkiye Travel Office <noreply@turkiyetraveloffice.com>
# Where new-application notifications go; defaults to EMAIL_FROM.
ADMIN_NOTIFY_EMAIL=

# Payments. While these are empty no payment option is offered anywhere.
# Webhook endpoint: https://<site>/api/travel/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional error tracking. Without a DSN, crashes are only written to logs.
# Create a Sentry project and paste the DSN here — no rebuild needed.
SENTRY_DSN=
